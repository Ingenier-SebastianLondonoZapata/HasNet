	<parameter name="id" class="java.lang.String"/>
	<parameter name="info" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT p.contrato, p.factura, p.usuario, p.fecha, p.convenio, p.tipoServicio, p.fechaAprovado, p.fechaDesenvolso, p.observaciones, p.valorSolicitado, p.valorAprovado, p.cuotas, p.interes, p.totalInteres,    p.total, c.numCuota, c.fecha AS fechaCuota, c.fechaAbono, c.abonoCapital,    c.abonoInteres, c.total AS totalCuota, c.totalAbono, c.mora, t.nombre,    CURDATE() AS hoy, t.direccion, t.celular, t.telefono, t.id AS cliente,
p.cuotaInicial, vf.vendedor 
FROM bdprestamo p LEFT JOIN bdcuota c ON c.contrato = p.contrato
LEFT JOIN bdterceros t ON t.idSistema = p.cliente
INNER JOIN bdverificadorfacturas vf ON vf.idFactura = p.factura
WHERE p.contrato = $P{id}
ORDER BY c.numCuota;]]>
	</queryString>
