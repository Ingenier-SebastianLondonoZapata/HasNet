	<queryString>
		<![CDATA[SELECT
    d.idDocumento AS ordenId,
    CAST(SUBSTR(bdterceros.id, 1, 100) AS SIGNED) AS cliente,
    bdterceros.ciudad AS ciudad,
    d.vendedor AS vendedor,
    d.red AS red,
    d.fechaFactura AS fechaFactura,
    d.fechaVencimiento AS fechaVencimiento,
    d.efectivoGeneral AS efectivoGeneral,
    d.ncGeneral AS ncGeneral,
    d.chequeGeneral AS chequeGeneral,
    d.targetaGeneral AS targetaGeneral,
    d.totalGeneral AS totalGeneral,
    d.descuentoGeneral AS descuentoGeneral,
    d.ivaGeneral AS ivaGeneral,
    d.subtotalGeneral AS subtotalGeneral,
    d.comprobante AS comprobante,
    d.cotizacion AS cotizacion,
    d.anulada AS anulada,
    d.anula AS anula,
    d.credito AS credito,
    d.cxc AS cxc,
    d.usuario AS usuario,
    d.rtIva AS rtIva,
    d.rtIca AS rtIca,
    d.rtFuente AS rtFuente,
    d.otros AS otros,
    d.observacion AS observacion,
    CAST(0 AS UNSIGNED) AS anulada1,
    '' AS anula1,
    CAST(0 AS UNSIGNED) AS credito1,
    '' AS cxc1,
    '' AS usuario1,
    d.fechaAlerta AS fechaAlerta,
    d.terminal AS terminal,
    d.estadoGeneral AS estadoGeneral,
    d.estado2 AS estado2,
    d.devuelta AS devuelta,
    d.factura AS factura,
    d.resolucion AS resolucion,
    d.fechaAnulacion AS fechaAnulacion,
    d.cuadreAnulacion AS cuadreAnulacion,
    d.usuarioAnula AS usuarioAnula,
    d.copago AS copago,
    d.garantia AS garantia,
    d.diasGarantia AS diasGarantia,
    dd.rango AS rango,
    d.terminos AS terminos,
    d.notaAnulacion AS notaAnulacion,
    d.conseMesa AS conseMesa,
    dd.producto AS producto,
    dd.lista AS lista,
    IF($P{agrupar}, SUM(dd.cantidad), MAX(dd.cantidad)) AS cantidad,
    IF($P{agrupar}, SUM(dd.descuento), MAX(dd.descuento)) AS descuento,
    IF($P{agrupar}, SUM(dd.total), MAX(dd.total)) AS total,
    IF($P{agrupar}, SUM(dd.iva), MAX(dd.iva)) AS iva,
    IF($P{agrupar}, SUM(dd.subtotal), MAX(dd.subtotal)) AS subtotal,
    '' AS NC,
    IF($P{agrupar}, SUM(dd.utilidad), MAX(dd.utilidad)) AS utilidad,
    '' AS concepto,
    dd.porcDescuento AS porcDescuento,
    dd.descripcion AS descripcion,
    dd.plu AS plu,
    IF($P{agrupar}, SUM(dd.cant2), MAX(dd.cant2)) AS cant2,
    dd.estado AS estado,
    dd.porcIva AS porcIva,
    dd.tercero AS tercero,
    dd.utilidad1 AS utilidad1,
    bdterceros.nombre AS nombre,
    bdterceros.telefono AS telefono,
    bdterceros.direccion AS direccion,
    IFNULL((SELECT pr.cuotaInicial FROM bdprestamo pr WHERE pr.factura = d.factura ORDER BY pr.contrato LIMIT 1), 0) AS cuotaInicial2,
    d.factura AS id2,
    bdproductos.ubicacion1 AS ubicacion1,
    bdproductos.referencia AS referencia,
    (d.subtotalGeneral - d.descuentoGeneral) AS valor3,
    (SELECT c.plazo FROM bdcxc c WHERE c.factura2 = d.factura AND c.tipo <> 'ABONO' ORDER BY c.Id LIMIT 1) AS plazo,
    bdterceros.nombreContacto AS nombreContacto,
    bdterceros.cargo AS cargo,
    IF(d.turno IS NULL OR TRIM(d.turno) IN ('', '0'), '', d.turno) AS turno,
    bdproductos.grupo AS Grupo,
    bdterceros.eps AS eps,
    bdepsprecargados.nombre AS nombreEps,
    dd.idDetalle AS Id,
    d.placa AS placa,
    (SELECT pl.tipo FROM bdplacas pl WHERE pl.placa = d.placa ORDER BY pl.Id LIMIT 1) AS tipo,
    (SELECT pa.fIngreso FROM bdparqueaderoautos pa WHERE pa.factura = d.factura ORDER BY pa.Id LIMIT 1) AS fIngreso,
    (SELECT pa.fSalida FROM bdparqueaderoautos pa WHERE pa.factura = d.factura ORDER BY pa.Id LIMIT 1) AS fSalida,
    (SELECT pa.hIngreso FROM bdparqueaderoautos pa WHERE pa.factura = d.factura ORDER BY pa.Id LIMIT 1) AS hIngreso,
    (SELECT pa.hSalida FROM bdparqueaderoautos pa WHERE pa.factura = d.factura ORDER BY pa.Id LIMIT 1) AS hSalida,
    (SELECT pa.horas FROM bdparqueaderoautos pa WHERE pa.factura = d.factura ORDER BY pa.Id LIMIT 1) AS horas,
    dd.detalle AS detalle,
    bddetalleproductos.color AS color,
    bdterceros.idSistema AS idSistema,
    IF($P{agrupar}, SUM(dd.impoconsumo), MAX(dd.impoconsumo)) AS impoconsumo,
    bdproductos.Codigo AS Codigo,
    d.totalPropina AS totalPropina,
    d.horaFactura AS hora,
    dd.idProd AS idProd,
    bdgrupo.nombre AS nombreGrupo,
    d.impoconsumoGeneral AS impoGeneral,
    dd.porcImpo AS porcImpo,
    d.bodega AS bodega
FROM (bdDocumentos d INNER JOIN bdDocumentosDetalle dd ON dd.idDocumento = d.idDocumento AND (d.tipoDocumento = $P{tipoDocumento} OR ($P{tipoDocumento} = 'facturacion' AND d.tipoDocumento = 'notaDebito')))
    LEFT JOIN bddetalleproductos ON dd.idProd = bddetalleproductos.Id
    LEFT JOIN bdproductos ON dd.producto = bdproductos.idSistema
    LEFT JOIN bdterceros ON d.cliente = bdterceros.idSistema
    LEFT JOIN bdepsprecargados ON bdepsprecargados.Id = bdterceros.eps
    LEFT JOIN bdgrupo ON bdproductos.grupo = bdgrupo.codigo
WHERE d.factura = $P{numFactura}
    AND ($P{grupo} IS NULL
        OR ($P{grupo} = '' AND bdproductos.grupo IS NULL)
        OR bdproductos.grupo = $P{grupo})
GROUP BY IF($P{agrupar},
        CONCAT_WS('|', d.factura, dd.producto, dd.lista, dd.descuento,
                  dd.plu, dd.porcIva, dd.porcImpo),
        dd.idDetalle)
ORDER BY MIN(dd.idDetalle)]]>
	</queryString>
