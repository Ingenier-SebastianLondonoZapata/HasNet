<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repAZ" language="java" whenNoDataType="NoDataSection" pageWidth="615" pageHeight="612" orientation="Landscape" columnWidth="595" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="2b7614af-cc13-4558-a3a4-b653eb40e1bb">
	<import value="java.math.BigDecimal"/>
	<parameter name="cliente" class="java.lang.String"/>
	<parameter name="mensaje" class="java.lang.String"/>
	<parameter name="simbolo" class="java.lang.String"/>
	<parameter name="cadenaDecimales" class="java.lang.String"/>
	<parameter name="encabezado" class="java.lang.String"/>
	<parameter name="parameter1" class="java.lang.String"/>
	<parameter name="regimen" class="java.lang.String"/>
	<queryString><![CDATA[SELECT dd.producto AS producto,
dd.descripcion AS descripcion,
SUM(dd.total) AS total,
SUM(dd.iva) AS iva,
SUM(dd.cantidad) AS cantidad,
bdproductos.Codigo AS Codigo 
FROM ((bdDocumentos d INNER JOIN bdDocumentosDetalle dd ON dd.idDocumento = d.idDocumento AND d.tipoDocumento IN ('facturacion', 'notaDebito')) LEFT JOIN bdproductos ON 
((bdproductos.idSistema = dd.producto)))
WHERE d.fechaFactura  BETWEEN $P!{cliente}  
GROUP BY dd.producto, dd.descripcion, bdproductos.Codigo, d.anulada
HAVING (d.anulada = 0)]]></queryString>
	<field name="Codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Double"/>
	<field name="iva" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="total_2" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
	</variable>
	<variable name="total_3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{iva}]]></variableExpression>
	</variable>
	<variable name="total_4" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
