		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT d.idDocumento AS ordenId, t.nombre AS nombre, t.id AS cliente, d.vendedor AS vendedor, d.red AS red, d.fechaVencimiento AS fechaVencimiento, d.efectivoGeneral AS efectivoGeneral, d.ncGeneral AS ncGeneral, d.chequeGeneral AS chequeGeneral, d.targetaGeneral AS targetaGeneral, d.totalGeneral AS totalGeneral, d.descuentoGeneral AS descuentoGeneral, d.ivaGeneral AS ivaGeneral, d.subtotalGeneral AS subtotalGeneral, d.comprobante AS comprobante, d.cotizacion AS cotizacion, d.anulada AS anulada, d.anula AS anula, d.credito AS credito, d.cxc AS cxc, d.usuario AS usuario, d.rtIva AS rtIva, d.rtIca AS rtIca, d.rtFuente AS rtFuente, d.otros AS otros, d.observacion AS observacion, CAST(0 AS UNSIGNED) AS anulada1, '' AS anula1, CAST(0 AS UNSIGNED) AS credito1, '' AS cxc1, '' AS usuario1, d.fechaAlerta AS fechaAlerta, d.terminal AS terminal, d.estadoGeneral AS estadoGeneral, d.estado2 AS estado2, d.devuelta AS devuelta, d.factura AS factura, d.resolucion AS resolucion, d.fechaAnulacion AS fechaAnulacion, d.cuadreAnulacion AS cuadreAnulacion, d.usuarioAnula AS usuarioAnula, d.placa AS placa, d.garantia AS garantia, d.diasGarantia AS diasGarantia, (SELECT x.rango FROM bdDocumentosDetalle x WHERE x.idDocumento = d.idDocumento ORDER BY x.idDetalle LIMIT 1) AS rango, d.terminos AS terminos, d.notaAnulacion AS notaAnulacion, d.conseMesa AS conseMesa, d.factura AS id2, d.copago AS copago, (SELECT pr.cuotaInicial FROM bdprestamo pr WHERE pr.factura = d.factura ORDER BY pr.contrato LIMIT 1) AS cuotaInicial2, d.fechaFactura AS fechaFactura, d.turno AS turno, t.idSistema AS idSistema, d.fechaFactura AS fechaFactura1, d.impoconsumoGeneral AS impoconsumo, d.tarjetaCredito AS tarjetaCredito, d.horaFactura AS hora, d.totalPropina AS totalPropina
FROM bdDocumentos d LEFT JOIN bdterceros t ON t.idSistema = d.cliente
$P!{cliente}]]></queryString>
	<field name="factura" class="java.lang.String"/>
