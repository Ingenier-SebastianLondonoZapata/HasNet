<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repProductos" language="java" whenNoDataType="NoDataSection" pageWidth="1210" pageHeight="612" orientation="Landscape" columnWidth="1190" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="811fc194-34c7-4ea0-b59b-85908be2e301">
	<import value="java.math.BigDecimal"/>
	<parameter name="cliente" class="java.lang.String"/>
	<parameter name="encabezado" class="java.lang.String"/>
	<parameter name="simbolo" class="java.lang.String"/>
	<parameter name="cadenaDecimales" class="java.lang.String"/>
	<queryString><![CDATA[SELECT * FROM (
    SELECT p.idSistema, p.Codigo, p.Descripcion, p.grupo AS Grupo, g.nombre AS GrupoDesc, s.nombre AS SubGrupoDesc,
           p.Proveedor, t.nombre AS nombreProveedor, COALESCE(p.IVA, 0) AS IVA, COALESCE(p.L1, 0) AS L1, COALESCE(l.L2, 0) AS L2, COALESCE(l.L3, 0) AS L3, COALESCE(l.L4, 0) AS L4, COALESCE(l.L5, 0) AS L5, COALESCE(l.L6, 0) AS L6, COALESCE(l.L7, 0) AS L7, COALESCE(l.L8, 0) AS L8, COALESCE(l.L9, 0) AS L9, COALESCE(l.L10, 0) AS L10, COALESCE(l.L11, 0) AS L11, COALESCE(l.L12, 0) AS L12, COALESCE(l.L13, 0) AS L13, COALESCE(l.L14, 0) AS L14, COALESCE(l.L15, 0) AS L15, COALESCE(l.L16, 0) AS L16, COALESCE(l.L17, 0) AS L17, COALESCE(l.L18, 0) AS L18, COALESCE(l.L19, 0) AS L19, COALESCE(l.L20, 0) AS L20,
           p.Usuario, p.activo, COALESCE(p.minimo, 0) AS minimo, p.unidad, COALESCE(p.costo, 0) AS costo, p.referencia, p.ubicacion1
    FROM bdProductos p
    LEFT JOIN bdGrupo g ON g.codigo = p.grupo
    LEFT JOIN (SELECT codigo, MIN(nombre) AS nombre FROM bdSubgrupo GROUP BY codigo) s ON s.codigo = p.Sub_grupo
    LEFT JOIN bdTerceros t ON t.idSistema = p.Proveedor
    LEFT JOIN (
        SELECT idSistema,
           MAX(CASE WHEN numeroLista = 2 THEN precio END) AS L2,
           MAX(CASE WHEN numeroLista = 3 THEN precio END) AS L3,
           MAX(CASE WHEN numeroLista = 4 THEN precio END) AS L4,
           MAX(CASE WHEN numeroLista = 5 THEN precio END) AS L5,
           MAX(CASE WHEN numeroLista = 6 THEN precio END) AS L6,
           MAX(CASE WHEN numeroLista = 7 THEN precio END) AS L7,
           MAX(CASE WHEN numeroLista = 8 THEN precio END) AS L8,
           MAX(CASE WHEN numeroLista = 9 THEN precio END) AS L9,
           MAX(CASE WHEN numeroLista = 10 THEN precio END) AS L10,
           MAX(CASE WHEN numeroLista = 11 THEN precio END) AS L11,
           MAX(CASE WHEN numeroLista = 12 THEN precio END) AS L12,
           MAX(CASE WHEN numeroLista = 13 THEN precio END) AS L13,
           MAX(CASE WHEN numeroLista = 14 THEN precio END) AS L14,
           MAX(CASE WHEN numeroLista = 15 THEN precio END) AS L15,
           MAX(CASE WHEN numeroLista = 16 THEN precio END) AS L16,
           MAX(CASE WHEN numeroLista = 17 THEN precio END) AS L17,
           MAX(CASE WHEN numeroLista = 18 THEN precio END) AS L18,
           MAX(CASE WHEN numeroLista = 19 THEN precio END) AS L19,
           MAX(CASE WHEN numeroLista = 20 THEN precio END) AS L20
        FROM bdProductosListas
        GROUP BY idSistema
    ) l ON l.idSistema = p.idSistema
) Productos $P!{cliente}]]></queryString>
