<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repAjuste" language="java" whenNoDataType="NoDataSection" pageWidth="840" pageHeight="612" orientation="Landscape" columnWidth="820" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="1451f71c-8601-4b30-8c68-c8220aff5018">
	<import value="java.math.BigDecimal"/>
	<parameter name="cliente" class="java.lang.String"/>
	<parameter name="encabezado" class="java.lang.String"/>
	<parameter name="totalizar" class="java.lang.String"/>
	<parameter name="simbolo" class="java.lang.String"/>
	<parameter name="cadenaDecimales" class="java.lang.String"/>
	<queryString><![CDATA[SELECT * FROM (
    SELECT d.traslado,
           t.fecha,
           d.producto,
           d.descripcion,
           d.cantidad,
           d.lista,
           d.total,
           t.unidades,
           t.valor,
           t.anulada,
           d.observacion,
           t.tipo,
           t.terminal,
           COALESCE(b.nombre, t.origen) AS bodega,
           p.Codigo,
           t.hora,
           t.usuario
    FROM bdTraslados t
    INNER JOIN bdTrasladosDetalle d ON d.traslado = t.Id
    INNER JOIN bdProductos p ON p.idSistema = d.producto
    LEFT JOIN bdBodegas b ON b.codigo = t.origen
) repTraslados $P!{cliente}
ORDER BY fecha ASC, traslado ASC]]></queryString>
	<field name="Codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Double"/>
	<field name="lista" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="traslado" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="hora" class="java.sql.Time"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="bodega" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<variable name="total_3" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
	</variable>
	<variable name="grupo_3" class="java.lang.Double" resetType="Group" resetGroup="grupo" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
	</variable>
	<variable name="total_5" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="grupo_5" class="java.math.BigDecimal" resetType="Group" resetGroup="grupo" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="cantidadGrupos" class="java.lang.Integer" incrementType="Group" incrementGroup="grupo" calculation="Count">
		<variableExpression><![CDATA[$F{traslado}]]></variableExpression>
	</variable>
