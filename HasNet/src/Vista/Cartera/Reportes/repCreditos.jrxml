<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repCreditos" language="java" whenNoDataType="NoDataSection" pageWidth="1150" pageHeight="612" orientation="Landscape" columnWidth="1130" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="5c629626-33eb-40d3-9d22-12fe581fda5d">
	<import value="java.math.BigDecimal"/>
	<parameter name="cliente" class="java.lang.String"/>
	<parameter name="encabezado" class="java.lang.String"/>
	<parameter name="parameter1" class="java.lang.String"/>
	<parameter name="simbolo" class="java.lang.String">
		<defaultValueExpression><![CDATA["$"]]></defaultValueExpression>
	</parameter>
	<parameter name="cadenaDecimales" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT * FROM (SELECT p.contrato AS factura, d.vendedor AS vendedor, d.cliente AS cliente, t.nombre AS nombre, d.fechaFactura AS fechaFactura, (SELECT cx.vencimiento FROM bdcxc cx WHERE cx.factura2 = d.factura AND cx.tipo IN ('FACT', 'SEPARE') AND cx.estado <> 'CANCELADA' ORDER BY cx.Id LIMIT 1) AS vencimiento, p.valorAprovado AS valorAprovado, LEFT(p.interes, 1000) AS interes2, p.totalInteres AS totalInteres, p.cuotas AS cuotas, (SELECT SUM(c.totalAbono) FROM bdcuota c WHERE c.contrato = p.contrato) AS SumaDetotalAbono, IFNULL(cc.CuentaDetotal2, '0') AS cuotasAbonadas, IFNULL(ca.CuentaDeestado, '0') AS cuotasAtrasadas FROM bdprestamo p INNER JOIN bdDocumentos d ON d.factura = p.factura2 AND d.tipoDocumento IN ('facturacion', 'notaDebito') AND d.anulada = 0 LEFT JOIN bdterceros t ON t.idSistema = d.cliente LEFT JOIN contcuentas3 cc ON cc.contrato = p.contrato LEFT JOIN contatrasadas3 ca ON ca.contrato = p.contrato WHERE EXISTS (SELECT 1 FROM bdcuota c WHERE c.contrato = p.contrato)) consultaCuentasPagadas2 $P!{cliente} ORDER BY factura ASC]]></queryString>
	<field name="factura" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="vendedor" class="java.lang.String"/>
	<field name="fechaFactura" class="java.sql.Timestamp"/>
	<field name="vencimiento" class="java.sql.Timestamp"/>
	<field name="valorAprovado" class="java.math.BigDecimal"/>
	<field name="interes2" class="java.lang.String"/>
	<field name="totalInteres" class="java.math.BigDecimal"/>
	<field name="cuotas" class="java.math.BigDecimal"/>
	<field name="SumaDetotalAbono" class="java.math.BigDecimal"/>
	<field name="cuotasAbonadas" class="java.lang.String"/>
	<field name="cuotasAtrasadas" class="java.lang.String"/>
	<variable name="total_6" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valorAprovado}]]></variableExpression>
	</variable>
	<variable name="total_8" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalInteres}]]></variableExpression>
	</variable>
	<variable name="total_10" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SumaDetotalAbono}]]></variableExpression>
	</variable>
