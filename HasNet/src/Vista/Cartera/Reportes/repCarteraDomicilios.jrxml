<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repCarteraDomicilios" language="java" whenNoDataType="NoDataSection" pageWidth="835" pageHeight="612" orientation="Landscape" columnWidth="815" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="9a1936c5-c467-43c8-b5ec-6465a14fb95b">
	<import value="java.math.BigDecimal"/>
	<parameter name="total" class="java.lang.String"/>
	<parameter name="regimen" class="java.lang.String"/>
	<parameter name="conseManual" class="java.lang.String"/>
	<parameter name="simbolo" class="java.lang.String"/>
	<parameter name="cadenaDecimales" class="java.lang.String"/>
	<queryString><![CDATA[SELECT * FROM (SELECT d.factura AS fact, cx.tipo AS tipo, cx.estado AS estado, cx.recibo AS recibo, cx.plazo AS plazo, cx.vencimiento AS vencimiento, d.cliente AS cliente, t.nombre AS nombre, d.fechaFactura AS fechaFactura, d.anulada AS anulada, IF((SELECT SUM(a.valor) FROM bdcxc a WHERE a.factura2 = d.factura AND a.tipo = 'ABONO' AND a.estado = 'ABONO-REALIZADO') IS NULL, cx.valor, cx.valor - (SELECT SUM(a.valor) FROM bdcxc a WHERE a.factura2 = d.factura AND a.tipo = 'ABONO' AND a.estado = 'ABONO-REALIZADO')) AS Expr1, d.vendedor AS vendedor, d.factura AS factura, d.terminal AS terminal, d.factura AS factura2, cx.valor AS valor, t.telefono AS telefono, CAST((cx.vencimiento - CAST(NOW() AS DATE)) AS SIGNED) AS edadCartera, IF(CAST(NOW() AS DATE) >= cx.vencimiento, 'VENCIDA', 'OK') AS estadoVenc, d.turno AS turno, d.placa AS placa, t.direccion AS direccion, t.ciudad AS ciudad, t.id AS idSistema, d.conseMesa AS conseMesa FROM bdcxc cx INNER JOIN bdDocumentos d ON d.factura = cx.factura2 AND d.tipoDocumento IN ('facturacion', 'notaDebito') LEFT JOIN bdterceros t ON t.idSistema = d.cliente WHERE cx.tipo = 'FACT' AND cx.estado <> 'CANCELADA' AND d.anulada = 0) repCartera2 $P!{total} ORDER BY cliente, factura DESC, tipo ASC]]></queryString>
