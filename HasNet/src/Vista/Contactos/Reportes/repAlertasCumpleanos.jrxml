	<queryString><![CDATA[SELECT id, nombre, tipoTercero, nacimiento, TIMESTAMPDIFF(YEAR, nacimiento, CURDATE()) AS edad, telefono, celular, direccion FROM bdTerceros WHERE nacimiento IS NOT NULL $P!{consulta} ORDER BY MONTH(nacimiento), DAY(nacimiento), nombre]]></queryString>
