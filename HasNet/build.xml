<?xml version="1.0" encoding="UTF-8"?>

<project name="HasNet" default="default" basedir=".">
    
    <target name="package-for-store" depends="jar">  
     <property name="store.jar.name" value="HasNet"/>  
     <property name="store.dir" value="JarCompleto"/>  
     <property name="store.jar" value="${store.dir}/${store.jar.name}.jar"/>  
     <echo message="Packaging ${application.title} into a single JAR at ${store.jar}"/>  
     <delete dir="${store.dir}"/>  
     <mkdir dir="${store.dir}"/>  
     <jar destfile="${store.dir}/temp_final.jar" filesetmanifest="skip">  
       <zipgroupfileset dir="dist" includes="*.jar"/>  
       <zipgroupfileset dir="dist/lib" includes="*.jar"/>  
       <manifest>  
         <attribute name="Main-Class" value="${main.class}"/>  
       </manifest>  
     </jar>  
     <zip destfile="${store.jar}">  
       <zipfileset src="${store.dir}/temp_final.jar"  
       excludes="META-INF/*.SF, META-INF/*.DSA, META-INF/*.RSA"/>  
     </zip>  
     <delete file="${store.dir}/temp_final.jar"/>
    </target>

    <target name="-post-jar">
        <property name="activador.dir" value="instalador/salida/Activador"/>
        <mkdir dir="${activador.dir}"/>
        <jar destfile="${activador.dir}/ActivadorHasNet.jar">
            <fileset dir="${build.classes.dir}">
                <include name="Activacion/**"/>
                <include name="Utilidades/Constantes*.class"/>
                <include name="Utilidades/BaseDatos/CredencialesBaseDatos*.class"/>
                <include name="Utilidades/Seguridad/IdentidadInstalacion*.class"/>
            </fileset>
            <zipfileset src="${file.reference.mysql-connector-j-8.0.33.jar}" excludes="META-INF/*.SF, META-INF/*.DSA, META-INF/*.RSA, META-INF/MANIFEST.MF"/>
            <manifest>
                <attribute name="Main-Class" value="Activacion.VistaActivacion"/>
            </manifest>
        </jar>
        <copy todir="${activador.dir}">
            <fileset dir="instalador" includes="activar-terminal.bat,hasnet-instalacion.dat"/>
        </copy>
    </target>

    <description>Construye y corre el proyecto HasNet.</description>
    <import file="nbproject/build-impl.xml"/>

</project>
